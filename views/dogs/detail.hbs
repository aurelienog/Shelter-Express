<main class="w-[80%] mx-auto bg-primary-color">

  <header>

    <section class="mx-auto flex flex-col items-center bg-linear p-8">
        
        <input type="checkbox" id="toggle-next" class="peer/toggle-next hidden"/>
        <input type="checkbox" id="toggle-prev" class="peer/toggle-prev hidden"/>

      <div class="order-last pt-6">

        <label for="toggle-prev" class="rounded-full px-4 py-3 bg-white/40 font-mono font-bold transition-all hover:bg-white cursor-pointer"><</label>
        <label for="toggle-next" class="rounded-full px-4 py-3  bg-white/40 font-mono font-bold transition-all hover:bg-white cursor-pointer">></label>

      </div>

      <figure class="md:grid md:grid-cols-[2fr_1fr] md:grid-rows-2 gap-6 md:max-h-[800px] overflow-hidden ">
        
        <img src="{{getImageByIndex dog.images 0}}" alt="{{dog.name}}'s photo" class=" mb-4 md:mb-0 col-start-1 row-span-full h-full rounded-lg aspect-[4/3] object-cover">

        <figure class="row-start-1 row-end-2 aspect-[4/3] overflow-hidden rounded-lg">
          <img src="{{getImageByIndex dog.images 1}}" alt="{{dog.name}}'s photo" class="mb-4 md:mb-0 w-full object-cover">
        </figure>

        <figure class="row-start-2 row-end-3  aspect-[4/3] overflow-hidden rounded-lg">
          <img src="{{getImageByIndex dog.images 2}}" alt="{{dog.name}}'s photo" class="mb-4 md:mb-0 w-full object-cover">
        </figure>
          
          
      </figure>

    </section> 

    <section class="bg-slate-200 p-8 my-auto">

      <div class="w-[90%] mx-auto">
      
        <div class="flex justify-between items-center mb-8">

          <div class="flex">
            <h2 class="text-5xl capitalize">{{dog.name}}</h2>
          </div>
          
          {{#isAdmin currentUser}}
          <div class="md:flex gap-8">

              <form method="post" action="/dogs/{{../dog.id}}/delete">
                <div class="flex items-center gap-1">
                  <img src="../../assets/remove.svg" alt="" class="w-8">
                  <button type="submit" class="inline-block">Remove</button> 
                </div>  
              </form>
            


              <div class="flex items-center gap-1">
                <img src="../../assets/edit.svg" alt="" class="w-8">
                <a href="/dogs/{{../dog.id}}/update">Edit</a>
              </div>
            
          </div>
          {{/isAdmin}}

        </div>

        <p class="mb-8 leading-6">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Fugiat nam error voluptatem vero, assumenda ullam voluptatibus dolorum eveniet! Inventore ratione ut mollitia impedit! Ullam at, cum excepturi nemo cupiditate commodi!</p>

        <div class="md:grid md:grid-cols-[minmax(300px,_1fr)_auto] gap-8">
          
          <article class="grid grid-cols-2 col-start-1 grid-flow-row gap-2 ">

            {{#if dog.license}}

            <div class="rounded-lg md:col-span-full bg-white/60 p-2 flex items-center gap-3">
              <div class="w-12">
                <img src="../../assets/warning.png" alt="" class="w-10 justify-self-end">
              </div>
              <p class="text-2xl">You need an administrative license to pick me !</p>
            </div>
            
            {{/if}}

            <div class="rounded-lg bg-white/60 p-2 flex items-center gap-3">
              <figure class="w-12">
                {{#isSex dog "male"}}<img src="../../assets/male.png" alt="" class="w-10 justify-self-end">{{/isSex}}
                {{#isSex dog "female"}}<img src="../../assets/female.png" alt="" class="w-10 justify-self-end">{{/isSex}}
              </figure>
              <div>
                <h3>Sex</h3>
                <p>{{dog.sex}}</p>
              </div>
            </div>

            <div class="rounded-lg bg-white/80 p-2 flex items-center gap-3">
              <figure class="w-12">
                <img src="../../assets/age.png" alt="" class="w-10 justify-self-end">
              </figure>
              <div>
                <h3>Age</h3>
                <p>{{dog.age}} years old</p>
              </div>
            </div>


            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/size.png" alt="" class=" w-11 justify-self-end">
              </figure>
              <div>
                <h3>Size</h3>
                <p>{{dog.size}}</p>
              </div>
            </div>

            {{#if dog.weight}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/kg.png" alt="" class="w-10">
              </figure>
              <div>
                <h3>Weight</h3>
                <p>{{dog.weight}} kg</p>
              </div>
            </div>
            {{/if}}

            {{#if dog.breed}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/dog.png" alt="" class="">
              </figure>
              <div>
                <h3>Breed</h3>
                <p>{{dog.breed}}</p>
              </div>
            </div>
            {{/if}}

            {{#if dog.idealHome}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/homeIdeal.png" alt="" class="">
              </figure>
              
              <div>
                <h3>Ideal home</h3>
                <p>{{dog.idealHome}}</p>
              </div>
            </div>
            {{/if}}

            {{#if dog.livingWithChildren}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/children.png" alt="" class="w-11">
              </figure>
              
              <div>
                <h3>Living with children</h3>
                <p>{{dog.livingWithChildren}}</p>
              </div>
            </div>
            {{/if}}

            {{#if dog.livingWithDogs}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/chien.png" alt="" class="w-11">
              </figure>
              <div>
                <h3>Living with dogs</h3>
                <p>{{dog.livingWithDogs}}</p>
              </div>     
            </div>
            {{/if}}

            {{#if dog.livingWithCats}}
            <div class="rounded-lg bg-white/80 p-4 flex items-center gap-3">
              <figure class="w-11">
                <img src="../../assets/chat.png" alt="" class="w-10">
              </figure>
              <div>
                <h3>Living with cats</h3>
                <p>{{dog.livingWithCats}}</p>
              </div> 
            </div>                
            {{/if}}

          </article>

          <article class="mt-8 md:m-0 col-start-2 rounded-lg  bg-white/80 row-span-full justify-items-center p-8  ">
              <h3 class="text-3xl mb-8">Apply to adopt {{dog.name}}</h3>
              <div class="flex flex-col gap-2 my-4">
                <a href="" class="inline-block text-center w-full rounded-lg bg-cta text-white p-4 mb-4">Start your application</a>
                <a href="" class="inline-block text-center w-full rounded-lg border bg-white/80 p-4">Add to favourites</a>
              </div>
          </article>
        </div>


    {{#if dog.about}}
      <div class="mb-8 mx-auto">
        <h3 class="text-3xl">More about {{dog.name}}:</h3>
        <p>{{dog.about}}</p>
      </div>
    {{/if}}
    
      </div>
    </section>


    <section class="w-[90%] p-8 mx-auto">
      <h2>Adoption process</h2>
    </section>


  </header>

</main>